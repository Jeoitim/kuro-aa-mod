+void OpticalFlowD3D12::start_shader_prewarm()
+{
+	if(shader_prewarmer.joinable() || !kuro_shader_cache::option(L"StartupPrewarm") || !kuro_shader_cache::option(L"ShaderDiskCache"))return;
+	cancel_prewarm=false;
+	try { shader_prewarmer=std::thread([]{
+		SetThreadPriority(GetCurrentThread(),THREAD_PRIORITY_BELOW_NORMAL);
+		for(uint32_t q=0;q<2 && !cancel_prewarm;++q){
+			const D3D_SHADER_MACRO macros[]={{"AEON_FLOW_QUALITY",q==0?"1":"2"},{nullptr,nullptr}};
+			for(uint32_t i=0;i<kFirstModelShader && !cancel_prewarm;++i){
+				ID3DBlob *code=nullptr,*error=nullptr;
+				kuro_shader_cache::compile(kFlowHlsl,std::strlen(kFlowHlsl),"aeon_flow",macros,nullptr,entry_of(i),"cs_5_0",D3DCOMPILE_OPTIMIZATION_LEVEL3,0,&code,&error);
+				safe_release(code);safe_release(error);
+			}
+		}
+		diag_logf(DiagLevel::Info,"cache",L"flow shader prewarm finished: memory hits=%u disk hits=%u compiles=%u",
+			kuro_shader_cache::memory_hits.load(),kuro_shader_cache::disk_hits.load(),kuro_shader_cache::misses.load());
+	}); } catch (...) { diag_warn("cache",L"shader prewarm thread unavailable; compile on demand"); }
+}
+void OpticalFlowD3D12::stop_shader_prewarm(){cancel_prewarm=true;if(shader_prewarmer.joinable())shader_prewarmer.join();}
